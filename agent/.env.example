# ==================== LLM CONFIG ====================
# Provider: openai | anthropic | google | nvidia | ollama | deepseek
LLM_PROVIDER=nvidia

# Quick Model (cho analyst, researcher)
QUICK_MODEL=Nemotron 70B
# Hoặc: GPT-4o-mini, Claude 3.5 Haiku, Gemini 2.0 Flash, Llama 3.1 70B

# Deep Model (cho research manager, portfolio manager)
DEEP_MODEL=Nemotron 70B
# Hoặc: GPT-4o, Claude Sonnet 4, Gemini 2.5 Pro

# API Keys (tùy provider)
LLM_API_KEY=your_api_key_here
# Hoặc dùng NVIDIA_API_KEY cho NVIDIA NIM

# Base URL (tùy provider, optional)
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# Temperature
LLM_TEMPERATURE=0.7

# Max Tokens (optional)
# LLM_MAX_TOKENS=4096

# ==================== NVIDIA NIM (Alternative) ====================
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# ==================== DNSE API ====================
DNSE_API_KEY=your_dnse_api_key_here
DNSE_API_SECRET=your_dnse_api_secret_here

# ==================== WEB SEARCH ====================
# Tavily Search (optional)
TAVILY_API_KEY=tvly-dev-your_tavily_api_key_here

# Firecrawl Self-hosted (default: http://localhost:3002)
FIRECRAWL_API_URL=http://localhost:3002

# ==================== MCP SERVER ====================
# MCP Server Config (optional - uses defaults)
# MCP_COMMAND=bun
# MCP_ARGS=["run", "src/index.ts"]
# MCP_CWD=/Users/cuongpham/Deverlop/typescript/dnse/mcp

# ==================== PROVIDER EXAMPLES ====================

# --- OpenAI ---
# LLM_PROVIDER=openai
# QUICK_MODEL=GPT-4o-mini
# DEEP_MODEL=GPT-4o
# LLM_API_KEY=sk-your_openai_key

# --- Anthropic ---
# LLM_PROVIDER=anthropic
# QUICK_MODEL=Claude 3.5 Haiku
# DEEP_MODEL=Claude Sonnet 4
# LLM_API_KEY=sk-ant-your_anthropic_key

# --- Google Gemini ---
# LLM_PROVIDER=google
# QUICK_MODEL=Gemini 2.0 Flash
# DEEP_MODEL=Gemini 2.5 Pro
# LLM_API_KEY=your_google_key

# --- Ollama (Local) ---
# LLM_PROVIDER=ollama
# QUICK_MODEL=Llama 3.1 8B
# DEEP_MODEL=Llama 3.1 70B
# LLM_BASE_URL=http://localhost:11434/v1

# --- DeepSeek ---
# LLM_PROVIDER=deepseek
# QUICK_MODEL=DeepSeek V3
# DEEP_MODEL=DeepSeek V3
# LLM_API_KEY=your_deepseek_key
