
# ==================== LLM CONFIG ====================
# Provider: openai | anthropic | google | nvidia | ollama | deepseek
LLM_PROVIDER=nvidia

# Quick Model (cho analyst, researcher)
QUICK_MODEL=Nemotron 70B

# Deep Model (cho research manager, portfolio manager)
DEEP_MODEL=Nemotron 70B

# API Key
LLM_API_KEY=your_api_key_here
# Hoặc dùng NVIDIA_API_KEY cho NVIDIA NIM

# ==================== DNSE API ====================
DNSE_API_KEY=your_dnse_api_key_here
DNSE_API_SECRET=your_dnse_api_secret_here

# ==================== WEB SEARCH ====================
TAVILY_API_KEY=your_tavily_api_key_here
FIRECRAWL_API_URL=http://localhost:3002

# ==================== DATABASE (SQLite via Prisma) ====================
# File-based SQLite (tự động tạo .data/dnse.db khi chạy)
DATABASE_URL=file:./.data/dnse.db

# ==================== TELEGRAM BOT ====================
# Lấy token từ @BotFather trên Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Chat ID được phép dùng bot (lấy từ @userinfobot). Nhiều ID cách nhau dấu phẩy. Để trống = cho phép tất cả
TELEGRAM_ALLOWED_CHAT_IDS=123456789
